# DeepSeek Game RTS - 环境变量示例
# 复制本文件为 .env 并填入真实 Key 后重启服务。
# Key 缺省时游戏自动进入纯规则 AI 模式（降级），不影响游玩。

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖默认端口（默认 3000）
PORT=3000

# 可选：覆盖模型（默认 deepseek-v4-flash，已关闭思考模式）
DEEPSEEK_MODEL=deepseek-v4-flash

# 豆包（火山方舟 ARK）：不配置则选择豆包的 AI 侧自动降级为规则 AI
ARK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ARK_MODEL=doubao-seed-2-1-turbo-260628
# ARK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 小米 MiMo：不配置则选择 MiMo 的 AI 侧自动降级为规则 AI
MIMO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MIMO_MODEL=mimo-v2.5
# MIMO_ENDPOINT=https://api.xiaomimimo.com/v1/chat/completions
